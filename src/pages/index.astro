---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCover from '../components/GameCover.astro';
import GameGrid from '../components/GameGrid.astro';
import Icon from '../components/Icon.astro';
import { CATEGORY_LABELS, featuredGame, games, getCategoryCounts } from '../data/games';
import type { GameCategory } from '../games/engine/types';

const featured = featuredGame;
if (!featured) throw new Error('[home] El catálogo necesita al menos un juego.');

const counts = getCategoryCounts();
const categories = (Object.keys(counts) as GameCategory[]).filter(
  (category) => counts[category] > 0,
);

const recentGames = games.map((game) => ({
  slug: game.slug,
  title: game.title,
  category: CATEGORY_LABELS[game.category],
  duration: game.duration,
  accent: game.accent,
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'gacarbla juegos',
    url: 'https://games.gacarbla.es',
    description:
      'Treinta y cinco juegos originales para jugar un rato sin prisa. Sin anuncios, sin cuentas y sin notificaciones.',
    inLanguage: 'es',
    publisher: {
      '@type': 'Organization',
      name: 'gacarbla',
      url: 'https://gacarbla.es',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Catálogo de juegos',
    itemListElement: games.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: game.title,
      url: `https://games.gacarbla.es/jugar/${game.slug}/`,
    })),
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__ambient" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy reveal">
        <p class="eyebrow eyebrow--lime">Un rincón para jugar sin prisa</p>
        <h1 class="display">Un rato de juego.<br /><em>Cero prisa.</em></h1>
        <p class="lede">
          Treinta y cinco juegos originales para desconectar un momento. Sin anuncios, sin cuentas y
          sin nada que te empuje a seguir. Cuando quieras parar, paras.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href="#catalogo">
            Ver los juegos
            <Icon name="arrow-down" size={16} />
          </a>
          <a class="btn btn--ghost btn--lg" href="#sin-prisa">Cómo jugamos</a>
        </div>
        <ul class="hero__notes">
          <li><Icon name="clock" size={15} /> Partidas de 2 a 10 minutos</li>
          <li><Icon name="heart" size={15} /> Sin anuncios ni cuentas</li>
          <li><Icon name="pause" size={15} /> Puedes parar cuando quieras</li>
        </ul>
      </div>

      <div class="hero__feature reveal" style="--reveal-delay: 120ms">
        <div class="hero-feature" style={`--accent:${featured.accent}`}>
          <div class="hero-feature__top">
            <span>Para empezar</span>
            <span>{CATEGORY_LABELS[featured.category]}</span>
          </div>
          <a
            class="hero-feature__cover"
            href={`/jugar/${featured.slug}/`}
            aria-label={`Jugar a ${featured.title}`}
          >
            <GameCover game={featured} />
            <span class="hero-feature__play">
              <Icon name="play" size={13} />
              Jugar
            </span>
          </a>
          <div class="hero-feature__body">
            <div class="hero-feature__head">
              <h2>{featured.title}</h2>
              <span class="tag">{CATEGORY_LABELS[featured.category]}</span>
            </div>
            <p>{featured.tagline}</p>
            <div class="hero-feature__foot">
              <span>
                <Icon name="clock" size={12} />
                {featured.duration}
              </span>
              <a href={`/jugar/${featured.slug}/`}>
                Jugar un rato
                <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="promise-band">
    <div class="container promise-band__inner">
      <div class="promise-band__item">
        <Icon name="shield" size={17} />
        <span><strong>Sin anuncios ni cuentas.</strong> Solo el juego.</span>
      </div>
      <div class="promise-band__item">
        <Icon name="clock" size={17} />
        <span><strong>Partidas cortas.</strong> Sin relojes ni rachas.</span>
      </div>
      <div class="promise-band__item">
        <Icon name="lock" size={17} />
        <span><strong>Tu progreso se queda aquí.</strong> Sin tracking.</span>
      </div>
    </div>
  </div>

  <section class="continue container" data-recent-section hidden>
    <div class="continue__head">
      <h2 class="eyebrow">Tus partidas recientes</h2>
      <button class="continue__clear" type="button" data-clear-recent>Limpiar historial</button>
    </div>
    <div class="continue__list" data-recent-list></div>
    <script
      type="application/json"
      data-games-json
      is:inline
      set:html={JSON.stringify(recentGames)}
    />
  </section>

  <section class="section catalog" id="catalogo">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">El catálogo</p>
          <h2>Elige con calma.</h2>
        </div>
        <a class="link-arrow" href="/juegos/">
          Ver todos los juegos
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div data-catalog>
        <div class="catalog-toolbar">
          <div class="filters" role="group" aria-label="Filtrar por categoría">
            <button class="chip" type="button" data-filter="todos" aria-pressed="true">
              Todos
              <span>{String(games.length).padStart(2, '0')}</span>
            </button>
            {
              categories.map((category) => (
                <button class="chip" type="button" data-filter={category} aria-pressed="false">
                  {CATEGORY_LABELS[category]}
                  <span>{String(counts[category]).padStart(2, '0')}</span>
                </button>
              ))
            }
          </div>

          {
            games.length >= 3 && (
              <label class="search">
                <Icon name="search" size={16} />
                <input
                  type="search"
                  placeholder="Buscar un juego…"
                  aria-label="Buscar juego"
                  data-game-search
                />
                <button class="search__clear" type="button" data-search-clear>
                  Borrar
                </button>
              </label>
            )
          }
        </div>

        <GameGrid games={games} />

        <div class="catalog-empty" data-empty hidden>
          <Icon name="search" size={28} />
          <h3>Nada por aquí</h3>
          <p>Prueba con otra categoría o con menos palabras.</p>
          <button class="btn btn--ghost btn--sm" type="button" data-reset-filters>
            Ver todos los juegos
          </button>
        </div>

        <p class="sr-only" aria-live="polite" data-results-live></p>
      </div>
    </div>
  </section>

  <section class="section manifesto" id="sin-prisa">
    <div class="container">
      <div class="manifesto__head">
        <div>
          <p class="eyebrow">Jugar sin prisa</p>
          <h2>Jugar no debería<br /><span class="accent">pedirte nada.</span></h2>
        </div>
        <p>
          Nos gustan los juegos que caben en una pausa y se dejan cerrar sin remordimiento. Por eso
          no hay anuncios, ni cuentas, ni notificaciones, ni recompensas que te llamen a volver.
          Solo treinta y cinco juegos bien hechos.
        </p>
      </div>

      <ol class="principles">
        <li>
          <Icon name="clock" size={20} />
          <span>01 · Partidas cortas</span>
          <h3>Para un rato, no para un día</h3>
          <p>
            Cada juego está pensado para una pausa de dos a diez minutos. Sin relojes que metan
            prisa y sin partidas que no terminan nunca.
          </p>
        </li>
        <li>
          <Icon name="shield" size={20} />
          <span>02 · Sin presión</span>
          <h3>Ni anuncios, ni rachas, ni avisos</h3>
          <p>
            No hay monedas, misiones diarias ni mensajes que te reclamen. Si cierras la pestaña, no
            pasa nada.
          </p>
        </li>
        <li>
          <Icon name="heart" size={20} />
          <span>03 · Se puede dejar</span>
          <h3>Vuelve cuando te apetezca</h3>
          <p>
            Puedes pausar, salir y retomar. Tu mejor marca y tu progreso se quedan en este
            navegador, sin cuentas ni comparaciones.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <script>
    import '../scripts/catalog';
    import '../scripts/recent';
  </script>
</BaseLayout>
