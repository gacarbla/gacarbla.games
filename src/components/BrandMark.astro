---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 44 44"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="22" cy="12.6" r="8.6" fill="#2f5d50"></circle>
  <circle cx="31.4" cy="22" r="8.6" fill="#df8b6c"></circle>
  <circle cx="22" cy="31.4" r="8.6" fill="#8fb397"></circle>
  <circle cx="12.6" cy="22" r="8.6" fill="#7fa9c2"></circle>
  <circle cx="22" cy="22" r="5" fill="#fffaf0" stroke="#24332d" stroke-width="1.6"></circle>
</svg>
