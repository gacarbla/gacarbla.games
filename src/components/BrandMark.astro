---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="16" cy="16" r="13.5" stroke="currentColor" stroke-opacity=".18"></circle>
  <path
    d="M28.4 22.2A13.5 13.5 0 0 0 16 2.5"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"></path>
  <path
    d="M3.6 9.8A13.5 13.5 0 0 0 16 29.5"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-opacity=".35"></path>
  <circle cx="24.3" cy="7.7" r="2.6" fill="var(--lime, #c8ff4d)"></circle>
  <circle cx="16" cy="16" r="3.4" fill="currentColor"></circle>
  <circle
    cx="16"
    cy="16"
    r="7.2"
    stroke="currentColor"
    stroke-opacity=".28"
    stroke-dasharray="1.5 3.2"></circle>
</svg>
