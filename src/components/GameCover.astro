---
import type { GameMeta } from '../data/games';

interface Props {
  game: GameMeta;
  class?: string;
  decorative?: boolean;
}

const { game, class: className = '', decorative = true } = Astro.props;
---

<div
  class={`cover ${className}`}
  style={`--accent:${game.accent}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : `Portada de ${game.title}`}
  aria-hidden={decorative ? 'true' : undefined}
>
  {
    game.thumbnail ? (
      <img
        class="cover__image"
        src={game.thumbnail}
        alt={decorative ? '' : `Portada de ${game.title}`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="cover__default">
        <span class="cover__name">{game.title}</span>
      </div>
    )
  }
</div>
