---
import type { GameMeta } from '../data/games';

interface Props {
  game: GameMeta;
  index?: number;
  class?: string;
  decorative?: boolean;
}

const { game, index, class: className = '', decorative = true } = Astro.props;
const number = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
---

<div
  class={`cover cover--${game.cover} ${className}`}
  style={`--accent:${game.accent}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : `Portada de ${game.title}`}
  aria-hidden={decorative ? 'true' : undefined}
>
  <div class="cover__grid"></div>
  <div class="cover__glow"></div>

  <svg class="cover__motif" viewBox="0 0 400 300" fill="none" aria-hidden="true">
    {
      number && (
        <text
          x="200"
          y="190"
          text-anchor="middle"
          font-family="Fraunces Variable, Georgia, serif"
          font-size="150"
          font-weight="500"
          fill="#24332d"
          fill-opacity=".075"
          letter-spacing="-6"
        >
          {number}
        </text>
      )
    }
    {
      game.cover === 'orbit' && (
        <g>
          <g class="cover__spin">
            <circle
              cx="200"
              cy="150"
              r="108"
              stroke="#24332d"
              stroke-opacity=".22"
              stroke-width="2"
            />
            <circle
              cx="200"
              cy="150"
              r="78"
              stroke="#8fb397"
              stroke-width="2.5"
              stroke-dasharray="5 10"
              stroke-linecap="round"
            />
            <circle
              cx="200"
              cy="150"
              r="48"
              stroke="#24332d"
              stroke-opacity=".2"
              stroke-width="2"
            />
            <path
              d="M92 150a108 108 0 0 0 216 0"
              stroke="#24332d"
              stroke-width="3"
              stroke-linecap="round"
            />
            <circle cx="308" cy="150" r="9" fill="#df8b6c" stroke="#24332d" stroke-width="2" />
            <circle cx="200" cy="42" r="7" fill="#7fa9c2" stroke="#24332d" stroke-width="2" />
            <circle cx="278" cy="78" r="4" fill="#d9b95f" />
          </g>
          <circle cx="200" cy="150" r="32" fill="#fffaf0" stroke="#24332d" stroke-width="3" />
          <circle cx="200" cy="150" r="9" fill="#df8b6c" />
          <path
            d="M228 108l9 5-9 5-5-9 5-1z"
            fill="#8fb397"
            stroke="#24332d"
            stroke-width="1.7"
            stroke-linejoin="round"
          />
          <circle cx="84" cy="226" r="4" fill="#a78fbf" />
          <circle cx="326" cy="238" r="3" fill="#24332d" fill-opacity=".35" />
        </g>
      )
    }

    {
      game.cover === 'prism' && (
        <g>
          <path
            d="M200 62 276 212H124L200 62Z"
            fill="#fffaf0"
            stroke="#24332d"
            stroke-width="3"
            stroke-linejoin="round"
          />
          <path
            d="M200 62v150M124 212l76-150 76 150"
            stroke="#24332d"
            stroke-opacity=".14"
            stroke-width="2"
          />
          <path d="M36 150h84" stroke="#7fa9c2" stroke-width="3.5" stroke-linecap="round" />
          <path
            d="M120 150h34l28-50h38l30 50h114"
            stroke="#7fa9c2"
            stroke-width="3.5"
            stroke-linecap="round"
          />
          <path d="M200 212v30l58 24" stroke="#df8b6c" stroke-width="3.5" stroke-linecap="round" />
          <circle cx="36" cy="150" r="7" fill="#df8b6c" stroke="#24332d" stroke-width="2" />
          <rect
            x="159"
            y="93"
            width="18"
            height="18"
            rx="4"
            fill="#8fb397"
            stroke="#24332d"
            stroke-width="2"
            transform="rotate(45 168 102)"
          />
          <rect
            x="246"
            y="144"
            width="16"
            height="16"
            rx="4"
            fill="#d9b95f"
            stroke="#24332d"
            stroke-width="2"
            transform="rotate(45 254 152)"
          />
          <circle cx="314" cy="238" r="6" fill="#a78fbf" />
          <path d="M76 90l6 3-6 3-3-6 3 0z" fill="#d9b95f" />
        </g>
      )
    }

    {
      game.cover === 'fusion' && (
        <g class="cover__float">
          {[0, 1, 2].map((row) => (
            <g>
              {[0, 1, 2].map((column) => {
                const values = [
                  [2, 4, 8],
                  [1, 2, 4],
                  [4, 8, 16],
                ];
                const value = values[row]![column]!;
                const colors = ['#8fb397', '#7fa9c2', '#a78fbf', '#df8b6c', '#d9b95f'];
                const color = colors[(row + column) % colors.length]!;
                const x = 132 + column * 48;
                const y = 82 + row * 48;
                return (
                  <g>
                    <rect
                      x={x + 2}
                      y={y + 3}
                      width={40}
                      height={40}
                      rx="11"
                      fill="#24332d"
                      fill-opacity=".09"
                    />
                    <rect
                      x={x}
                      y={y}
                      width={40}
                      height={40}
                      rx="11"
                      fill={color}
                      stroke="#24332d"
                      stroke-width="2"
                    />
                    <text
                      x={x + 20}
                      y={y + 26}
                      text-anchor="middle"
                      font-family="DM Mono, monospace"
                      font-size="14"
                      font-weight="500"
                      fill="#24332d"
                    >
                      {value}
                    </text>
                  </g>
                );
              })}
            </g>
          ))}
          <path
            d="M312 96c13 0 24 10 24 23 0 7-3 12-8 16"
            stroke="#8fb397"
            stroke-width="3"
            stroke-linecap="round"
          />
          <path
            d="m324 126 5 12-13-4"
            fill="#8fb397"
            stroke="#24332d"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <circle cx="84" cy="214" r="5" fill="#df8b6c" />
          <circle cx="322" cy="212" r="4" fill="#24332d" fill-opacity=".3" />
        </g>
      )
    }

    {
      game.cover === 'pulse' && (
        <g>
          <circle
            cx="200"
            cy="150"
            r="106"
            stroke="#24332d"
            stroke-opacity=".16"
            stroke-width="2"
            stroke-dasharray="4 12"
          />
          <g class="cover__pulse">
            <rect
              x="138"
              y="88"
              width="54"
              height="54"
              rx="16"
              fill="#2f5d50"
              stroke="#24332d"
              stroke-width="2"
            />
            <circle cx="165" cy="115" r="7" fill="#fffaf0" />
            <path
              d="M157 115l6 6 11-13"
              stroke="#2f5d50"
              stroke-width="2.5"
              stroke-linecap="round"
            />
          </g>
          <g>
            <rect
              x="210"
              y="88"
              width="54"
              height="54"
              rx="16"
              fill="#7fa9c2"
              stroke="#24332d"
              stroke-width="2"
            />
            <circle cx="237" cy="115" r="7" fill="#fffaf0" fill-opacity=".8" />
          </g>
          <g>
            <rect
              x="138"
              y="168"
              width="54"
              height="54"
              rx="16"
              fill="#a78fbf"
              stroke="#24332d"
              stroke-width="2"
            />
            <circle cx="165" cy="195" r="7" fill="#fffaf0" fill-opacity=".8" />
          </g>
          <g>
            <rect
              x="210"
              y="168"
              width="54"
              height="54"
              rx="16"
              fill="#df8b6c"
              stroke="#24332d"
              stroke-width="2"
            />
            <circle cx="237" cy="195" r="7" fill="#fffaf0" fill-opacity=".8" />
          </g>
          <circle cx="200" cy="150" r="23" fill="#fffaf0" stroke="#24332d" stroke-width="2" />
          <circle cx="200" cy="150" r="7" fill="#d9b95f" />
          <circle cx="84" cy="82" r="4" fill="#df8b6c" />
          <circle cx="320" cy="224" r="5" fill="#8fb397" />
        </g>
      )
    }

    {
      game.cover === 'wave' && (
        <g>
          {[0, 1, 2, 3].map((line) => (
            <path
              d={`M20 ${112 + line * 25} C 90 ${72 + line * 25}, 150 ${172 + line * 12}, 210 ${124 + line * 25} S 330 ${82 + line * 20}, 380 ${124 + line * 25}`}
              stroke={line % 2 === 0 ? '#8fb397' : '#7fa9c2'}
              stroke-opacity={0.5 + line * 0.14}
              stroke-width="3"
              stroke-linecap="round"
            />
          ))}
          <circle cx="210" cy="150" r="11" fill="#fffaf0" stroke="#24332d" stroke-width="2.5" />
          <circle cx="210" cy="150" r="4" fill="#df8b6c" />
        </g>
      )
    }

    {
      game.cover === 'stack' && (
        <g>
          <rect
            x="112"
            y="198"
            width="176"
            height="30"
            rx="10"
            fill="#8fb397"
            stroke="#24332d"
            stroke-width="2"
          />
          <rect
            x="128"
            y="158"
            width="144"
            height="30"
            rx="10"
            fill="#7fa9c2"
            stroke="#24332d"
            stroke-width="2"
          />
          <rect
            x="146"
            y="118"
            width="108"
            height="30"
            rx="10"
            fill="#a78fbf"
            stroke="#24332d"
            stroke-width="2"
          />
          <rect
            x="166"
            y="78"
            width="68"
            height="30"
            rx="10"
            fill="#df8b6c"
            stroke="#24332d"
            stroke-width="2"
          />
          <circle cx="200" cy="48" r="7" fill="#d9b95f" stroke="#24332d" stroke-width="2" />
        </g>
      )
    }

    {
      game.cover === 'grid' && (
        <g>
          {[0, 1, 2, 3, 4].map((row) =>
            [0, 1, 2, 3, 4].map((column) => (
              <circle
                cx={128 + column * 36}
                cy={78 + row * 36}
                r={row === 2 && column === 2 ? 10 : 3}
                fill={
                  row === 2 && column === 2
                    ? '#2f5d50'
                    : (row + column) % 4 === 0
                      ? '#df8b6c'
                      : 'rgba(36,51,45,.24)'
                }
              />
            )),
          )}
        </g>
      )
    }
  </svg>

  {number && <span class="cover__index mono">{number}</span>}
</div>
