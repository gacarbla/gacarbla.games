---
import type { GameMeta } from '../data/games';
import GameCard from './GameCard.astro';

interface Props {
  games: readonly GameMeta[];
  class?: string;
  startIndex?: number;
}

const { games, class: className = '', startIndex = 0 } = Astro.props;
---

<div class:list={['game-grid', className]} data-game-grid>
  {games.map((game, index) => <GameCard game={game} index={startIndex + index} />)}
</div>
